#!/bin/sh
# pre-commit: die schnellen Pruefungen vor JEDEM Commit (unter einer Sekunde).
#
# Warum: Doku-Aenderungen gehen direkt auf main (CLAUDE.md, Regel 4). Die
# Hosttests laufen aber nur vor einem Merge und die CI erst nach dem Push -
# ein Doku-Commit, der nicht mehr zum Code passt, fiel also fruehestens auf
# GitHub auf. Der Hook schliesst diese Luecke, ohne eine eigene Testliste zu
# fuehren: Er ruft test/hosttests.sh --schnell, dort stehen alle Pruefungen.
#
# Aktivieren, einmal je Klon (git versioniert Hooks nicht von selbst):
#
#   git config core.hooksPath .githooks
#
# Im Notfall umgehen: git commit --no-verify - die CI prueft nach dem Push
# trotzdem alles.
#
# Grenze: Geprueft wird der Arbeitsbaum, nicht der gestagte Stand. Wer nur
# einen Teil seiner Aenderungen committet, prueft also mehr als er einreicht.
# Das ist Absicht - den Stand fuer den Test abzuspalten (stash) koennte bei
# einem Abbruch Aenderungen verstecken, und hier wird ohnehin fast immer
# alles auf einmal committet.

cd "$(git rev-parse --show-toplevel)" || exit 1

# Ausgabe nur zeigen, wenn etwas scheitert - ein gruener Hook bleibt still
AUSGABE=$(./test/hosttests.sh --schnell 2>&1)
if [ $? -ne 0 ]; then
    echo "$AUSGABE"
    echo ""
    echo "pre-commit: Pruefungen ROT - Commit abgebrochen."
    echo "Nur im Notfall umgehen: git commit --no-verify"
    exit 1
fi
exit 0
